[Unit]
Description=PiHiFiPlayer - McIntosh High-End Music Streamer (KMS/DRM Direct Boot)
After=network.target sound.target systemd-user-sessions.service
Conflicts=getty@tty1.service

[Service]
Type=simple
User=winheo
Group=winheo
WorkingDirectory=/home/winheo/pi-hifi-music

# 环境变量：强制 SDL2 使用底层 Linux 内核 KMS/DRM 驱动直通 HDMI 输出 (无需任何桌面环境)
Environment="SDL_VIDEODRIVER=kmsdrm"
Environment="SDL_RENDER_VSYNC=1"

# 绑定控制台 tty1，获取 DRM Master 显示主控权
StandardInput=tty
StandardOutput=journal
StandardError=journal
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes

# 启动可执行文件
ExecStart=/home/winheo/pi-hifi-music/build/PiHifiPlayer

# 进程异常退出自动复活
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
